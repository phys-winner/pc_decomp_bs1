+#if PAN_ARCH == 7
+static bool
+defer_occlusion_availability(struct panvk_cmd_buffer *cmd, uint64_t address)
+{
+   struct panvk_batch *batch = cmd->cur_batch;
+   /* Only a primary rendering batch and a driver explicitly selected by R10.
+    * Leave space for the next begin and any outstanding tiler jobs. */
+   if (!batch || !batch->fb.desc.gpu || batch->vtc_jc.job_index >= 0x8000 ||
+       cmd->vk.level != VK_COMMAND_BUFFER_LEVEL_PRIMARY ||
+       !debug_get_bool_option("R10_PANVK_DEFER_OCCLUSION", false))
+      return false;
+
+   if (!batch->occlusion_done) {
+      struct panvk_batch *done = vk_zalloc(&cmd->vk.pool->alloc, sizeof(*done),
+                                           8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+      if (!done)
+         return false;
+
+      done->jobs = UTIL_DYNARRAY_INIT;
+      done->event_ops = UTIL_DYNARRAY_INIT;
+      /* Its VTC atom waits for the previous fragment atom and joins the VTC
+       * timeline. Subsequent reset/copy commands and host completion therefore
+       * include these availability writes. The producer owns this batch
+       * until close transfers both to the command buffer in execution order. */
+      done->order = PANVK_BATCH_WAIT_FRAG;
+      batch->occlusion_done = done;
+   }
+
+   panvk_emit_write_job(cmd, batch->occlusion_done,
+                        MALI_WRITE_VALUE_TYPE_IMMEDIATE_32, address, 1);
+   return true;
+}
+#endif
